<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>eru</AssemblyName>
    <RootNamespace>Eru.Cli</RootNamespace>
    <PackageId>Eru.Tool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>eru</ToolCommandName>
    <Version>0.12.0</Version>
    <Authors>Devon Burriss</Authors>
    <Description>A CLI tool for sharing knowledge files across projects via git-backed sources.</Description>
    <Title>eru</Title>
    <Copyright>Copyright © 2025 Devon Burriss</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ai cli knowledge mcp dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>`eru print &lt;source:path|hash&gt;` prints a document's contents to stdout (`-o json` for `{source, path, hash, content}`). It resolves from the source indexes, so documents need not be added first, and reads the local file, then the cache, then a live fetch. A 3-8 character path hash that matches several documents errors and lists the candidates</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/dburriss/eru</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dburriss/eru</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Eru.Domain/Eru.Domain.fsproj" />
    <ProjectReference Include="../Eru.Adapters/Eru.Adapters.fsproj" />
    <ProjectReference Include="../Eru.Mcp/Eru.Mcp.fsproj" />
    <ProjectReference Include="../Eru.Tui/Eru.Tui.fsproj" />
    <ProjectReference Include="../Eru.Site/Eru.Site.fsproj" />
    <ProjectReference Include="../Eru.Serve/Eru.Serve.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Argu" Version="6.*" />
    <PackageReference Include="Spectre.Console" Version="0.*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Args.fs" />
    <Compile Include="OutputFormat.fs" />
    <Compile Include="SearchCli.fs" />
    <Compile Include="SyncCli.fs" />
    <Compile Include="AddCli.fs" />
    <Compile Include="InitCli.fs" />
    <Compile Include="SourceListCli.fs" />
    <Compile Include="SourceViewCli.fs" />
    <Compile Include="SourceFilesCli.fs" />
    <Compile Include="SourceAddCli.fs" />
    <Compile Include="SourceRemoveCli.fs" />
    <Compile Include="SourceBundleAddCli.fs" />
    <Compile Include="SourceBundleListCli.fs" />
    <Compile Include="SourceBundleRemoveCli.fs" />
    <Compile Include="InboxAddCli.fs" />
    <Compile Include="InboxListCli.fs" />
    <Compile Include="InboxRemoveCli.fs" />
    <Compile Include="InboxDefaultCli.fs" />
    <Compile Include="InboxChannelAddCli.fs" />
    <Compile Include="InboxChannelListCli.fs" />
    <Compile Include="InboxChannelRemoveCli.fs" />
    <Compile Include="InboxSendCli.fs" />
    <Compile Include="InboxProcessCli.fs" />
    <Compile Include="InboxWatchCli.fs" />
    <Compile Include="CollectionCreateCli.fs" />
    <Compile Include="CollectionAddFileCli.fs" />
    <Compile Include="CollectionRemoveFileCli.fs" />
    <Compile Include="ManifestInitCli.fs" />
    <Compile Include="ManifestAddCli.fs" />
    <Compile Include="ManifestRemoveCli.fs" />
    <Compile Include="ManifestValidateCli.fs" />
    <Compile Include="RemoveCli.fs" />
    <Compile Include="DisconnectCli.fs" />
    <Compile Include="PrintCli.fs" />
    <Compile Include="CachePruneCli.fs" />
    <Compile Include="CacheClearCli.fs" />
    <Compile Include="BrowseCli.fs" />
    <Compile Include="SiteGenerateCli.fs" />
    <Compile Include="SiteServeCli.fs" />
    <Compile Include="OkfValidateCli.fs" />
    <Compile Include="OkfFixCli.fs" />
    <Compile Include="OkfInitCli.fs" />
    <Compile Include="OkfVerifyCli.fs" />
    <Compile Include="GraphCli.fs" />
    <Compile Include="VersionCli.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>