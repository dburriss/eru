<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>eru</AssemblyName>
    <RootNamespace>Eru.Cli</RootNamespace>
    <PackageId>Eru.Tool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>eru</ToolCommandName>
    <Version>0.2.0</Version>
    <Authors>Devon Burriss</Authors>
    <Description>A CLI tool for sharing knowledge files across projects via git-backed sources.</Description>
    <Title>eru</Title>
    <Copyright>Copyright © 2025 Devon Burriss</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ai cli knowledge mcp dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>`--dryrun` flag for `collection create`, `collection add`, and `source add` — previews what would be written without modifying any config file</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/dburriss/eru</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dburriss/eru</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Eru.Domain/Eru.Domain.fsproj" />
    <ProjectReference Include="../Eru.Adapters/Eru.Adapters.fsproj" />
    <ProjectReference Include="../Eru.Mcp/Eru.Mcp.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Argu" Version="6.*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Args.fs" />
    <Compile Include="CommandMapper/CommandMapper.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>