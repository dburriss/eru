    <Compile Include="AddTests.fs" />
    <Compile Include="SyncTests.fs" />
    <Compile Include="SearchTests.fs" />
    <Compile Include="InitTests.fs" />
    <Compile Include="ManifestTests.fs" />
    <Compile Include="RemoveTests.fs" />
